		<p class="flex flex-1 flex-col items-center justify-center gap-2">
			<span
				><svg
					viewBox="0 0 64 64"
					id="icons"
					xmlns="http://www.w3.org/2000/svg"
					fill="currentColor"
					width="40px"
					height="40px"
					><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
						id="SVGRepo_tracerCarrier"
						stroke-linecap="round"
						stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"
						><defs
							><style>
								.cls-1 {
									fill: currentColor;
								}
							</style></defs
