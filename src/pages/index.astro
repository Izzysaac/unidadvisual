---
import Layout from "../layouts/Layout.astro";
// import BestSellers from "@components/BestSellers.astro";
import MainCategorias from "@components/MainCategories.astro";

import Reviews from "@components/Reviews.astro";
import FAQS from "@components/productPage/FAQS.astro";

const images = {
	hero: "https://res.cloudinary.com/dr5knskbb/image/upload/v1789857953/maria-david_nsasf5.webp",

};
// CollectionPage + ItemList + BreadcrumbList
const seo = {
	title: "Optica Unidad Visual",
	description:
		"Especialistas al cuidado de tus ojos"
};
---

<Layout title={seo.title} description={seo.description} hero={images.hero}>
	<div
		id="hero"
		class="m-auto flex max-w-120 flex-col items-center pt-19!"
	>
		<img src={images.hero} alt="Hero Image" class="object-contain w-full h-full" />


		<h1 class="block w-ful text-center text-lg font-bold text-black/90 mt-4">
			<span>Especialistas al cuidado de tus ojos</span>
		</h1>
		<p class="block w-full text-center mb-4">Cotiza tus gafas sin compromiso.</p>

		<div class="mt-auto mb-4 flex w-full flex-col gap-4 px-5 text-center">
			<a
				href="/productos"
				class="block rounded bg-(--accent) px-5 py-2 text-lg font-semibold text-(--on-accent)"
				>Ver catálogo</a
			>
			<p class="bg-gray-200 py-1">
				Solicite una montura nueva con un examen vigente y me ha ido súper bien, recomiendo el lugar, 10/10-
				⭐⭐⭐⭐⭐
			</p>
		</div>
	</div>

	<div
		class="flex items-center justify-center gap-4 bg-(--accent) py-6 text-center text-sm text-white/95"
