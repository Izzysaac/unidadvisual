---
import { getCldImageUrl } from 'astro-cloudinary/helpers';
const { name, description, media } = Astro.props;
---

<div class="wrapper flex w-full snap-x snap-mandatory gap-5 overflow-x-scroll">
	{
        media.map((mediaSrc, i) => (
            <figure
                class="card snap-center w-full max-w-125 shrink-0 box-border flex flex-col justify-center items-center text-center gap-2.5 aspect-square bg-white"
                style={`--thumb: url("${getCldImageUrl({ src: mediaSrc, width: 220, height: 220, quality: 'auto' })}")`}
            >
                <img src={getCldImageUrl({ src: mediaSrc, width: 1200, height: 1200 })} alt={`${name}-${description}-${i}`} />
            </figure>
        ))
    }
<!-- transition:name={`img-${mediaSrc}-${i}`} -->
</div>

<style>
	.wrapper {
		scroll-marker-group: after;
		scroll-behavior: smooth;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.wrapper::-webkit-scrollbar {
		display: none;
	}

	.wrapper::scroll-marker-group {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem 0 0;
		/* overflow-x: auto; */
		scrollbar-width: none;
	}

	.wrapper::scroll-marker-group::-webkit-scrollbar {
		display: none;
	}

	.card::scroll-marker {
		content: '';
		display: block;
		width: clamp(2.75rem, 7vw, 4.5rem);
		aspect-ratio: 1;
		border-radius: 0.6rem;
		background-image: var(--thumb);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		border: 2px solid transparent;
		box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
		opacity: 0.7;
		transform: scale(0.96);
		flex-shrink: 0;
		transition: transform 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
	}

	.card::scroll-marker:target-current {
		border-color: var(--accent);
		opacity: 1;
		transform: scale(1.04);
	}

	img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}
</style>