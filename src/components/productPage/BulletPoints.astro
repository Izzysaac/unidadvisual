---

const { modelo } = Astro.params;

const bulletPoints = [
    `📦 Envío <strong>GRATIS</strong> a toda colombia`,
    `🔄 Cambios y devoluciones <strong>FÁCILES</strong>`,
    `📞 Atención <strong>RÁPIDA</strong> por whatsapp`
];

---

<ul class="text-center py-2">
    {bulletPoints.map((point) => (
        <li class="bullet-point" set:html={point} />
    ))}
</ul>