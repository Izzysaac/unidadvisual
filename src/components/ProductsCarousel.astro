<!-- transition:name={`img-${mediaSrc}-${i}`} -->

<style>
	.wrapper {
		scroll-marker-group: after;
		scroll-behavior: smooth;
	}
	.wrapper::scroll-marker-group {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.5rem;
	}

	.card::scroll-marker {
		content: '';
		display: block;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background-color: black;
		flex-shrink: 0;
	}

	.card::scroll-marker:target-current {
		background-color: var(--accent);
	}

	img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

    .link::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1; /* Hace que el área clicable cubra toda la tarjeta */
	}
</style>    