---
import { getCldImageUrl } from 'astro-cloudinary/helpers';
const products  = [
    {
        image: "https://res.cloudinary.com/dr5knskbb/image/upload/v1791583056/perseo-gris_fimtk2-product-main.webp",
        name: "Perseo",
        url: "/productos/perseo"
    },
    {
        image: "https://res.cloudinary.com/dr5knskbb/image/upload/v1791582775/american-product-main.webp",
        name: "American",
        url: "/productos/american"
    },
    {
        image: "https://res.cloudinary.com/dr5knskbb/image/upload/v1791582985/dydm008-product-main.webp",
        name: "DYD M008",
        url: "/productos/dyd-m008"
    },
    {
        image: "https://res.cloudinary.com/dr5knskbb/image/upload/v1791582810/dyd-caballero-product-main.webp",
        name: "DYD Caballero",
        url: "/productos/dyd-caballero"
    },
    {
        image: "https://res.cloudinary.com/dr5knskbb/image/upload/v1791582859/atena_cbuxsk-product-main.webp",
        name: "Atena",
        url: "/productos/atena"
    }
]
---
<div class="overflow-x overflow-scroll flex gap-2 p-4 text-center text-sm text-black/90 snap-x snap-mandatory">
    {
        products.map((product, i) => (
            <article class="relative">
                <figure class="w-40 aspect-video">
                    <img src={product.image} alt="" class="w-full h-full object-cover" />
                </figure>
                {/* <p class="font-semibold uppercase bg-(--color-crema) py-2">{product.name}</p> */}
                <a href={product.url} class="font-semibold uppercase bg-(--color-crema) py-2 w-full link block">
                    {product.name}
                </a>
            </article>
        ))
    }
</div>

<!-- <div class="wrapper flex w-full snap-x snap-mandatory gap-2 overflow-x-scroll items-start">
	{
        reviews.map((review, i) => (
            <article class="card snap-center w-11/12 max-w-125 shrink-0 box-border flex flex-col justify-center items-center text-center gap-2.5 aspect-square bg-slate-100 py-3">
                <img src={review.image} alt="" />
                <span>⭐⭐⭐⭐⭐</span>
                <p class="text-lg font-bold">{review.name}</p>
            </article>
        ))
    }
